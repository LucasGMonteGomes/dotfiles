      "class ${TM_FILENAME_BASE} {",
      "",
      "    $0",
      "}"
    ]
  },
  "Teste de controller com MockMvc": {
    "prefix": "webmvctest",
    "description": "Classe @WebMvcTest com MockMvc injetado",
    "body": [
      "@WebMvcTest(${1:Controller}.class)",
      "class ${TM_FILENAME_BASE} {",
      "",
      "    @Autowired",
      "    private MockMvc mockMvc;",
      "",
      "    $0",
      "}"
    ]
  },
  "Requisicao GET no MockMvc": {
    "prefix": "mvcget",
    "description": "GET no MockMvc esperando status 200",
    "body": [
      "mockMvc.perform(MockMvcRequestBuilders.get(\"${1:/api}\"))",
      "        .andExpect(MockMvcResultMatchers.status().${2:isOk}())$0;"
    ]
  },
  "Requisicao POST no MockMvc": {
    "prefix": "mvcpost",
    "description": "POST no MockMvc com corpo JSON esperando status 201",
    "body": [
      "mockMvc.perform(MockMvcRequestBuilders.post(\"${1:/api}\")",
      "                .contentType(MediaType.APPLICATION_JSON)",
      "                .content(\"\"\"",
      "                        ${2:{\\}}",
      "                        \"\"\"))",
      "        .andExpect(MockMvcResultMatchers.status().${3:isCreated}())$0;"
    ]
  },
  "Endpoint GET": {
    "prefix": "getmap",
    "description": "@GetMapping com @PathVariable",
    "body": [
      "@GetMapping(\"/{${2:id}\\}\")",
      "public ResponseEntity<${1:Tipo}> ${3:buscar}(@PathVariable ${4:Long} ${2:id}) {",
      "    $0",
      "}"
    ]
  },
