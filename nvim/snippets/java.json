{
  "Teste JUnit (given/when/then)": {
    "prefix": "test",
    "description": "Metodo @Test com as secoes given/when/then",
    "body": [
      "@Test",
      "void ${1:deveFazerAlgo}() {",
      "    // given",
      "    $2",
      "",
      "    // when",
      "    $3",
      "",
      "    // then",
      "    $0",
      "}"
    ]
  },
  "Teste parametrizado": {
    "prefix": "ptest",
    "description": "@ParameterizedTest com @CsvSource",
    "body": [
      "@ParameterizedTest",
      "@CsvSource({",
      "    \"${2:1, 2}\",",
      "})",
      "void ${1:deveFazerAlgo}(${3:int entrada}, ${4:int esperado}) {",
      "    $0",
      "}"
    ]
  },
  "Preparacao antes de cada teste": {
    "prefix": "before",
    "description": "@BeforeEach void setUp()",
    "body": [
      "@BeforeEach",
      "void setUp() {",
      "    $0",
      "}"
    ]
  },
  "Teste esperando excecao": {
    "prefix": "athrows",
    "description": "assertThrows com a chamada que deve falhar",
    "body": [
      "${1:IllegalArgumentException} exception = assertThrows(${1:IllegalArgumentException}.class, () -> ${2:servico.executar()});",
      "$0"
    ]
  },
