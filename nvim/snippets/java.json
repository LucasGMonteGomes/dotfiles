  "Propriedade com @Value": {
    "prefix": "valprop",
    "description": "@Value(\"${propriedade}\") em um campo",
    "body": [
      "@Value(\"\\${${1:app.propriedade}\\}\")",
      "private ${2:String} ${3:propriedade};$0"
    ]
  },
  "Id JPA": {
    "prefix": "jpaid",
    "description": "@Id com @GeneratedValue IDENTITY",
    "body": [
      "@Id",
      "@GeneratedValue(strategy = GenerationType.IDENTITY)",
      "private ${1:Long} id;$0"
    ]
  },
  "Logger SLF4J": {
    "prefix": "logger",
    "description": "private static final Logger log da classe atual",
    "body": [
      "private static final Logger log = LoggerFactory.getLogger(${TM_FILENAME_BASE}.class);$0"
    ]
  },
  "Stream filter/map/toList": {
    "prefix": "stream",
    "description": "lista.stream().filter(...).map(...).toList()",
    "body": [
      "${1:lista}.stream()",
      "        .filter(${2:item} -> ${3:true})",
      "        .map(${4:item -> item})",
      "        .toList()$0"
    ]
  }
