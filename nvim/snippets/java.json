    "prefix": "postmap",
    "description": "@PostMapping com @RequestBody validado",
    "body": [
      "@PostMapping",
      "public ResponseEntity<${1:Tipo}> ${2:criar}(@RequestBody @Valid ${3:Request} request) {",
      "    $0",
      "}"
    ]
  },
  "Endpoint PUT": {
    "prefix": "putmap",
