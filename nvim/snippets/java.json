    "body": [
      "@PutMapping(\"/{${2:id}\\}\")",
      "public ResponseEntity<${1:Tipo}> ${3:atualizar}(@PathVariable ${4:Long} ${2:id}, @RequestBody @Valid ${5:Request} request) {",
      "    $0",
      "}"
    ]
  },
