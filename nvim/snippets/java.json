      "class ${TM_FILENAME_BASE} {",
      "",
      "    @Mock",
      "    private ${1:Repositorio} ${2:repositorio};",
      "",
      "    @InjectMocks",
      "    private ${3:Servico} ${4:servico};",
      "",
      "    $0",
      "}"
    ]
  },
  "Campo @Mock": {
    "prefix": "mock",
    "description": "@Mock private Tipo nome;",
    "body": [
      "@Mock",
      "private ${1:Tipo} ${2:nome};$0"
    ]
  },
  "Teste de integracao Spring Boot": {
